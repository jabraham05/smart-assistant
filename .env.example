# Copy to .env and fill in real values. .env is gitignored.

# Postgres superuser password for the `assistant` role (shared by postgres, n8n, honcho)
POSTGRES_PASSWORD=

# n8n workflow/credential encryption key
N8N_ENCRYPTION_KEY=

# Model to force-load into VRAM on startup (see ollama-warmup service). Optional, defaults to llama3.2:3b.
OLLAMA_WARMUP_MODEL=

# Chat Trigger node's Production URL, for scripts/chat.mjs (CLI connectivity test / reference client)
N8N_CHAT_WEBHOOK_URL=

# coding_task_pipeline workflow's Production URL, for scripts/start-coding-task.mjs
# (host-reachable form, e.g. http://localhost:5678/webhook/coding-task — kept
# separate from CODING_TASK_WEBHOOK_URL below, same pattern as N8N_CHAT_WEBHOOK_URL
# vs chat-ui's internal N8N_WEBHOOK_URL)
N8N_CODING_TASK_WEBHOOK_URL=

# Honcho API key, used by the chat-ui service for the session list/history. Get one at app.honcho.dev.
HONCHO_API_KEY=

# get_weather tool's fallback when no location is given in chat.
# Either HOME_LOCATION (geocoded at request time) or HOME_LATITUDE/HOME_LONGITUDE
# (skips the geocode round-trip) — set at least one for a useful default.
HOME_LOCATION=
HOME_LATITUDE=
HOME_LONGITUDE=

# skills-mcp's propose_new_skill tool POSTs here to record a proposal in the
# `skills` Data Table for human review. Points at the skill_proposal_intake
# n8n workflow's webhook (internal network only).
SKILLS_PROPOSAL_WEBHOOK_URL=http://n8n:5678/webhook/skill-proposal

# Calendar CRUD tools (list/create/update/delete). Optional — omit and the
# tools return a clear "not configured" error instead of breaking anything.
# GOOGLE_CALENDAR_ID is the calendar's ID from Google Calendar's settings
# ("Integrate calendar" section) — usually your Gmail address for your
# primary calendar. Also requires a service account key at
# secrets/google-calendar-key.json (see README's Google Calendar section)
# and sharing that calendar with the service account's email.
GOOGLE_CALENDAR_ID=

# skills-mcp's code_task tool POSTs here to start a coding_task_pipeline run
# (fire-and-forget — the webhook responds immediately, the actual work
# happens in the background). Optional — omit and the tool returns a clear
# "not configured" error instead of breaking anything.
CODING_TASK_WEBHOOK_URL=http://n8n:5678/webhook/coding-task

# GitHub fine-grained PAT (Contents: read/write, Pull requests: read/write),
# scoped to the specific target repo(s) the coding-agent pipeline is allowed
# to push branches to and open PRs against. Set ONLY on the sandbox-runner
# service, never on n8n — n8n stores every workflow execution's full node
# inputs/outputs in Postgres in plaintext, so this must never flow through
# a workflow's JSON body (see sandbox-runner/src/config.ts). Optional —
# omit and /propose-pr returns a clear "not configured" error; /execute
# (sandboxed test runs) also uses this to clone private repos, so it's
# needed for private targets even before any PR is opened.
GITHUB_TOKEN=

# Git commit author identity used for coding-agent commits. Optional,
# defaults to smart-assistant-bot / smart-assistant-bot@users.noreply.github.com.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# spotify_control tool. Optional — omit and the tool returns a clear
# "not configured" error instead of breaking anything. Unlike Google
# Calendar (a service account, no user interaction needed), Spotify
# playback control acts on a specific person's account and requires real
# user authorization. Setup:
#   1. Register an app at https://developer.spotify.com/dashboard
#   2. Add http://127.0.0.1:8888/callback as a Redirect URI in that app's settings
#   3. SPOTIFY_CLIENT_ID=... SPOTIFY_CLIENT_SECRET=... node scripts/spotify-auth.mjs
#      — prints a SPOTIFY_REFRESH_TOKEN value to add below
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
