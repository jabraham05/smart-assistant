# Copy to .env and fill in real values. .env is gitignored.

# Postgres superuser password for the `assistant` role (shared by postgres, n8n, honcho)
POSTGRES_PASSWORD=

# n8n workflow/credential encryption key
N8N_ENCRYPTION_KEY=

# Model to force-load into VRAM on startup (see ollama-warmup service). Optional, defaults to llama3.2:3b.
OLLAMA_WARMUP_MODEL=

# Chat Trigger node's Production URL, for scripts/chat.mjs (CLI connectivity test / reference client)
N8N_CHAT_WEBHOOK_URL=

# coding_task_pipeline workflow's Production URL, for scripts/start-coding-task.mjs
# (host-reachable form, e.g. http://localhost:5678/webhook/coding-task — kept
# separate from CODING_TASK_WEBHOOK_URL below, same pattern as N8N_CHAT_WEBHOOK_URL
# vs chat-ui's internal N8N_WEBHOOK_URL)
N8N_CODING_TASK_WEBHOOK_URL=

# Honcho API key, used by the chat-ui service for the session list/history. Get one at app.honcho.dev.
HONCHO_API_KEY=

# get_weather tool's fallback when no location is given in chat.
# Either HOME_LOCATION (geocoded at request time) or HOME_LATITUDE/HOME_LONGITUDE
# (skips the geocode round-trip) — set at least one for a useful default.
HOME_LOCATION=
HOME_LATITUDE=
HOME_LONGITUDE=

# calendar_event's reference for converting a bare local/wall-clock time
# ("3pm", "tomorrow morning") into the correct ISO offset instead of
# defaulting to UTC. IANA name, e.g. America/Los_Angeles. Optional, defaults
# to America/Los_Angeles if unset.
HOME_TIMEZONE=

# skills-mcp's propose_new_skill tool POSTs here to record a proposal in the
# `skills` Data Table for human review. Points at the skill_proposal_intake
# n8n workflow's webhook (internal network only).
SKILLS_PROPOSAL_WEBHOOK_URL=http://n8n:5678/webhook/skill-proposal

# Calendar CRUD tools (list/create/update/delete). Optional — omit and the
# tools return a clear "not configured" error instead of breaking anything.
# GOOGLE_CALENDAR_ID is the calendar's ID from Google Calendar's settings
# ("Integrate calendar" section) — usually your Gmail address for your
# primary calendar. Also requires a service account key at
# skills-mcp/secrets/google-calendar-key.json (baked into the image at
# build time, not bind-mounted, so a rebuild is needed after adding it
# — see README's Google Calendar section) and sharing that calendar
# with the service account's email.
GOOGLE_CALENDAR_ID=

# skills-mcp's code_task tool POSTs here to start a coding_task_pipeline run
# (fire-and-forget — the webhook responds immediately, the actual work
# happens in the background). Optional — omit and the tool returns a clear
# "not configured" error instead of breaking anything.
CODING_TASK_WEBHOOK_URL=http://n8n:5678/webhook/coding-task

# GitHub fine-grained PAT (Contents: read/write, Pull requests: read/write),
# scoped to the specific target repo(s) the coding-agent pipeline is allowed
# to push branches to and open PRs against. Set ONLY on the sandbox-runner
# service, never on n8n — n8n stores every workflow execution's full node
# inputs/outputs in Postgres in plaintext, so this must never flow through
# a workflow's JSON body (see sandbox-runner/src/config.ts). Optional —
# omit and /propose-pr returns a clear "not configured" error; /execute
# (sandboxed test runs) also uses this to clone private repos, so it's
# needed for private targets even before any PR is opened.
GITHUB_TOKEN=

# Git commit author identity used for coding-agent commits. Optional,
# defaults to smart-assistant-bot / smart-assistant-bot@users.noreply.github.com.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Max number of sandbox commands (clone/test/patch/etc.) a single coding
# task's container may run in its entire lifetime, shared across every
# retry attempt within that task, not reset per attempt (sandbox-runner/
# src/config.ts, src/executor.ts). Optional, defaults to 250 here (100 in
# code) — raise further for tasks spanning several files/attempts; a task
# that legitimately needs more just gets a clean resource_limit_reached
# outcome rather than a silent failure either way.
MAX_COMMANDS_PER_TASK=250

# event-bus's internal URL (skills-mcp's goal_manage tool, discord-bot, and
# coding-orchestrator all point at this to publish events / manage goals).
# No secret involved — same "always-on internal infra" tier as
# SANDBOX_RUNNER_URL, not a per-user optional integration. Not required to
# be set here; every service that uses it already defaults to this exact
# value in its own config.ts.
EVENT_BUS_URL=http://event-bus:3004

# Same "always-on internal infra" tier as EVENT_BUS_URL above - event-bus's
# calendar-watch.ts calls skills-mcp's /internal/calendar-events route to
# reuse its existing Google Calendar auth. Not required to be set here;
# event-bus already defaults to this exact value in its own config.ts.
SKILLS_MCP_URL=http://skills-mcp:3001

# How many days of no goal_progress_log activity before the stale-goal
# nudge workflow (goalsstalenudge1) considers a goal worth checking in on.
# Optional, defaults to 7.
GOAL_STALE_DAYS=7

# How many chat.message_received events must accumulate before
# skill_gap_scanner's frequent poll (every ~15min) actually runs its
# Honcho+Ollama reasoning branches, instead of every tick. Optional,
# defaults to 10.
SKILL_GAP_CHECK_MESSAGES=10

# event-bus's calendar poll-and-diff watcher (calendarwatch0001) and
# idle-time self-reflection (idlereflection0001). All optional, with
# sensible defaults - only worth overriding if you want a different
# reminder lead time or a more/less cautious proactive-messaging cadence.
#
# How close to a calendar event's start (minutes) before the one-time
# "starting soon" reminder fires for it. Defaults to 30.
CALENDAR_REMINDER_LEAD_MINUTES=30
# How far ahead (hours) each poll asks for upcoming calendar events.
# Defaults to 24.
CALENDAR_POLL_LOOKAHEAD_HOURS=24
# Which databases event-bus reads (read-only) to decide whether Amy's
# "work level" is high (a coding or research task is actively running) or
# low. Same Postgres host/user/password as everything else - just
# different database names. Defaults match postgres/init/02 and /03.
CODING_TASKS_DB_NAME=coding_tasks
RESEARCH_DB_NAME=research
# Minimum hours of continuous low work-level between idle-reflection
# reasoning runs. Defaults to 4.
IDLE_REFLECTION_MIN_HOURS=4
# Separate, stricter cooldown for the "message the user directly" outcome
# specifically (not the quieter "queue a skill proposal" outcome) - caps
# proactive DMs to at most one per this many hours, regardless of how often
# the reasoning step itself runs. Defaults to 24 (at most once a day).
IDLE_REFLECTION_MESSAGE_MIN_HOURS=24

# Landing repo for coding tasks with no existing target repo (a from-scratch
# build, i.e. code_task called without repoUrl) — one shared repo, one
# folder per task. Set on n8n only (not sandbox-runner, which is just a
# passthrough client). Must exist already; this project doesn't create it
# for you — one-time setup, same as the sandbox network/image below.
CODING_TASKS_REPO_URL=

# skills-mcp's code_task_status tool POSTs here (synchronously — it waits
# for the response) to look up a coding task's current progress for the
# chat session that started it. Points at coding_task_pipeline's status
# webhook (internal network only). Optional — omit and the tool returns a
# clear "not configured" error.
CODING_TASK_STATUS_WEBHOOK_URL=http://n8n:5678/webhook/coding-task-status

# spotify_control tool. Optional — omit and the tool returns a clear
# "not configured" error instead of breaking anything. Unlike Google
# Calendar (a service account, no user interaction needed), Spotify
# playback control acts on a specific person's account and requires real
# user authorization. Setup:
#   1. Register an app at https://developer.spotify.com/dashboard
#   2. Add http://127.0.0.1:8888/callback as a Redirect URI in that app's settings
#   3. SPOTIFY_CLIENT_ID=... SPOTIFY_CLIENT_SECRET=... node scripts/spotify-auth.mjs
#      — prints a SPOTIFY_REFRESH_TOKEN value to add below
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# web_search tool. Optional — omit and the tool returns a clear
# "not configured" error instead of breaking anything. Get a free key
# (1,000 searches/month, no card required) at https://tavily.com —
# sign up, the API key is on the dashboard immediately.
TAVILY_API_KEY=

# knowledge-engine: document ingestion, hybrid retrieval, and research —
# replaces research_pipeline (see docs/knowledge-engine.md). Always-on
# internal infra, not a per-user optional integration, so there's no
# "not configured" fallback — knowledge_search/knowledge_ingest/research_task
# just fail if this is unreachable. Reuses the existing `research` Postgres
# database; requires the same one-time pgvector setup as the old research
# pipeline, plus 08-create-knowledge-tables.sql.
KNOWLEDGE_ENGINE_URL=http://knowledge-engine:3005

# Model used by knowledge-engine to embed ingested/researched chunks and
# search queries. Must match whatever dimension the `embedding` column in
# 08-create-knowledge-tables.sql is created with (VECTOR(768), matching
# nomic-embed-text's output) — changing this without also updating the
# column type will fail at insert time, not silently produce bad results.
KNOWLEDGE_EMBEDDING_MODEL=nomic-embed-text

# knowledge-engine's deterministic knowledge-vs-web router (see
# engine/router.ts) - a knowledge-base search whose top result scores below
# this is treated as "not good enough," escalating to a live Tavily web
# search instead (reuses the same TAVILY_API_KEY as skills-mcp's web_search
# above). Originally chosen at 0.02 from one small single-document test
# corpus (a genuinely relevant top result scored ~0.03, a weak/tangential
# one ~0.015-0.016). Retuned to 0.012 after real dogfooding against a
# 286-chunk two-document corpus (a full Porsche Cayman 987 owner's manual):
# RRF scores shrink as the corpus grows, so a genuinely relevant top match
# (the manual's real "Brake Fluid Level" section, for a brake fluid
# question) scored only ~0.0164 - the old 0.02 threshold was escalating to
# a redundant web search that just rediscovered the same fact already in
# the manual. Likely to need retuning again as more domains/documents are
# added - this is a real, evolving tradeoff, not a one-time constant.
KNOWLEDGE_ROUTE_TO_WEB_THRESHOLD=0.012

# Second, independent gate alongside KNOWLEDGE_ROUTE_TO_WEB_THRESHOLD above:
# the top knowledge-base result must also share at least this many real,
# non-trivial keywords with the query (see engine/router.ts). Added after
# real dogfooding proved the RRF score alone can't tell a genuine match
# from an unrelated same-domain "best of a bad bunch" - a real brake-fluid
# question and a completely unrelated "Nissan GT-R" question against a
# Porsche-only knowledge base both scored ~0.0164, because a domain-filtered
# vector search always ranks *something* top-K regardless of true
# relevance. Kept deliberately low (1) so a real paraphrased match isn't
# rejected for lacking exact wording overlap.
KNOWLEDGE_MIN_KEYWORD_OVERLAP=1

# discord-bot: lets you talk to Amy over Discord DM from your phone,
# anywhere (no public tunnel/port-forwarding needed — the bot connects
# outbound to Discord's gateway). Setup:
#   1. Create an application at https://discord.com/developers/applications,
#      add a Bot to it, and copy its token into DISCORD_BOT_TOKEN below.
#   2. In the Bot page's "Privileged Gateway Intents" section, enable
#      "Message Content Intent" (required to read DM text at all).
#   3. Invite the bot to any server you're also in (OAuth2 URL Generator:
#      scope "bot", no permissions needed) — Discord only allows a user to
#      DM a bot if they share a server; you'll DM the bot directly after
#      that, not talk to it in the server.
#   4. Enable Developer Mode in Discord (User Settings > Advanced), right-
#      click your own username, "Copy User ID" -> DISCORD_ALLOWED_USER_ID.
#      Messages from any other user ID are silently ignored.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_ID=
